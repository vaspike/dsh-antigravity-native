{
  "name": "dsh-antigravity-native",
  "version": "0.1.2",
  "description": "Native DSH model, workspace, session and chat integration for existing Antigravity ACP logins.",
  "type": "module",
  "exports": {
    ".": "./src/host/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs && npm test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.5"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaspike/dsh-antigravity-native.git"
  },
  "homepage": "https://github.com/vaspike/dsh-antigravity-native#readme",
  "bugs": {
    "url": "https://github.com/vaspike/dsh-antigravity-native/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "antigravity",
    "acp",
    "gemini"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess-local": "^0.2.2-rc.5"
  }
}
